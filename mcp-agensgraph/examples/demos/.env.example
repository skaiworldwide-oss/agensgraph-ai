# The mcp-agensgraph demos talk to a live AgensGraph instance.
# The MCP servers are pure tools — NO OpenAI / Anthropic / other API key is needed.
# (Real LLM-driven usage is via Claude Desktop — see claude_desktop/.)
#
# All settings below are optional; the defaults match the local dev instance.
AGENS_HOST=127.0.0.1
AGENS_PORT=55432
AGENS_USER=
AGENS_PASSWORD=
