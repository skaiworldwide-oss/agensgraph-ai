# Copy to examples/demos/.env and fill in. Only OPENAI_API_KEY is required.
# Everything is used for embeddings + LLM calls via OpenAI — nothing runs locally.

OPENAI_API_KEY=

# AgensGraph connection. Defaults target the local dev instance:
#   host=localhost  port=55432  db=llamaindex_demos  user=$(whoami)  (trust auth, no password)
# Leave blank to use the defaults. (AGENSGRAPH_* names are also accepted as a fallback.)
AGENS_DB=llamaindex_demos
AGENS_USER=
AGENS_PASSWORD=
AGENS_HOST=localhost
AGENS_PORT=55432
# Or a single URL (takes precedence): postgresql://user:pwd@host:port/dbname
AGENS_URL=

# Model overrides (optional)
DEMO_EMBED_MODEL=text-embedding-3-small
DEMO_LLM_MODEL=gpt-4o-mini

# ── Scale knobs (optional; every demo is big-by-default and env-overridable) ──
# 01_arxiv_pg
ARXIV_LIMIT=50000
ARXIV_BATCH=1000
EMBED_CONCURRENCY=10
# ARXIV_RESET=1        # drop & rebuild the arxiv graph first
# 02_wikipedia_pgindex
WIKI_LIMIT=500
WIKI_CHARS=1800
# 03_news_vector_rag
NEWS_LIMIT=100000
NEWS_CHUNK_CHARS=900
NEWS_BATCH=1000
# NEWS_RESET=1
