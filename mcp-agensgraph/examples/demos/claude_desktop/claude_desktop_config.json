{
  "mcpServers": {
    "agensgraph-cypher": {
      "command": "uvx",
      "args": ["mcp-agensgraph-cypher@0.2.0", "--transport", "stdio"],
      "env": {
        "AGENSGRAPH_URL": "postgresql://127.0.0.1:55432",
        "AGENSGRAPH_USERNAME": "<your-username>",
        "AGENSGRAPH_PASSWORD": "",
        "AGENSGRAPH_DATABASE": "mcp_flights",
        "AGENSGRAPH_GRAPHNAME": "flights"
      }
    },
    "agensgraph-memory": {
      "command": "uvx",
      "args": ["mcp-agensgraph-memory@0.2.0", "--transport", "stdio"],
      "env": {
        "AGENSGRAPH_URL": "postgresql://127.0.0.1:55432",
        "AGENSGRAPH_USERNAME": "<your-username>",
        "AGENSGRAPH_PASSWORD": "",
        "AGENSGRAPH_DATABASE": "mcp_memory",
        "AGENSGRAPH_GRAPHNAME": "memory"
      }
    },
    "agensgraph-data-modeling": {
      "command": "uvx",
      "args": ["mcp-agensgraph-data-modeling@0.2.0", "--transport", "stdio"]
    }
  }
}
