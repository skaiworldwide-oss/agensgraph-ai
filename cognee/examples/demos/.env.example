# Copy to `.env` (in this folder) and fill in. The .env is git-ignored.
# Only OPENAI_API_KEY is strictly required; AgensGraph defaults to the local dev
# instance (trust auth on localhost:55432) and each demo uses its own database.

# --- OpenAI (all embeddings + LLM calls; nothing runs locally) ---
OPENAI_API_KEY=

# --- AgensGraph connection (AGENS_* or AGENSGRAPH_*; all optional under trust auth) ---
AGENS_USER=
AGENS_PASSWORD=
AGENS_HOST=localhost
AGENS_PORT=55432

# --- Optional model overrides ---
# DEMO_LLM_MODEL=gpt-4o-mini
# DEMO_EMBED_MODEL=openai/text-embedding-3-small
# DEMO_EMBED_DIM=1536

# --- Optional scale knobs (every build prints a cost estimate first) ---
# WIKI_LIMIT=350         # demo 1/5: Wikipedia articles
# NEWS_LIMIT=300         # demo 3: CC-News articles
# CODE_REPO=             # demo 4: path/URL of a Python repo (defaults to a small one)
