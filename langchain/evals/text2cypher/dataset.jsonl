# AgensGraph-dialect text2cypher dataset. One JSON entry per line; # lines are comments.
# gold = dialect-correct query, executed at scoring time (results are never stored).
# habit = the query a Neo4j-trained model writes; habit_outcome says why it is wrong here:
#   "error" (refused loudly) or "different" (runs, but disagrees with gold).
# requires: capability gates ("gql_clauses", "element_ordering", "boolean_condition") — skipped below 2.18.
{"id": "quote-label-01", "graph": "t2c_movies", "category": "quoting", "question": "How many Movie nodes are there?", "gold": "MATCH (m:\"Movie\") RETURN count(*) AS n", "habit": "MATCH (m:Movie) RETURN count(*) AS n", "habit_outcome": "different"}
{"id": "quote-type-02", "graph": "t2c_traps", "category": "quoting", "question": "Who does Ada know directly?", "gold": "MATCH (:\"Person\" {name: 'Ada'})-[:\"KNOWS\"]->(p) RETURN p.name AS name", "habit": "MATCH (:\"Person\" {name: 'Ada'})-[:KNOWS]->(p) RETURN p.name AS name", "habit_outcome": "different"}
{"id": "quote-prop-03", "graph": "t2c_traps", "category": "quoting", "question": "What is Ada's nickName?", "gold": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN p.'nickName' AS nickname", "habit": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN p.nickName AS nickname", "habit_outcome": "different"}
{"id": "quote-string-04", "graph": "t2c_traps", "category": "quoting", "question": "Return the string hello.", "gold": "RETURN 'hello' AS greeting", "habit": "RETURN \"hello\" AS greeting", "habit_outcome": "error"}
{"id": "quote-distinct-type-05", "graph": "t2c_movies", "category": "quoting", "question": "List the distinct relationship types that point into movies.", "gold": "MATCH ()-[r]->(:\"Movie\") RETURN DISTINCT type(r) AS t", "habit": "MATCH ()-[r]->(:Movie) RETURN DISTINCT type(r) AS t", "habit_outcome": "different"}
{"id": "quote-where-06", "graph": "t2c_movies", "category": "quoting", "question": "Which movies came out after 2021? Give title and year.", "gold": "MATCH (m:\"Movie\") WHERE m.year > 2021 RETURN m.title AS title, m.year AS year", "habit": "MATCH (m:Movie) WHERE m.year > 2021 RETURN m.title AS title, m.year AS year", "habit_outcome": "different", "expect_index": true}
{"id": "comment-dash-07", "graph": "t2c_traps", "category": "quoting", "question": "Count pairs of directly connected nodes, in any direction.", "gold": "MATCH (a)-[]-(b) RETURN count(*) AS n", "habit": "MATCH (a)--(b) RETURN count(*) AS n", "habit_outcome": "error"}
{"id": "comment-arrow-08", "graph": "t2c_traps", "category": "quoting", "question": "Count directed connections between any two nodes.", "gold": "MATCH (a)-[]->(b) RETURN count(*) AS n", "habit": "MATCH (a)-->(b) RETURN count(*) AS n", "habit_outcome": "error"}
{"id": "mutual-arrow-09", "graph": "t2c_traps", "category": "quoting", "question": "Which pairs of people know each other in BOTH directions?", "gold": "MATCH (a:\"Person\")-[:\"KNOWS\"]->(b:\"Person\"), (b)-[:\"KNOWS\"]->(a) RETURN a.name AS a, b.name AS b", "expect_empty": true, "habit": "MATCH (a:\"Person\")<-[:\"KNOWS\"]->(b:\"Person\") RETURN a.name AS a, b.name AS b", "habit_outcome": "different"}
{"id": "backtick-10", "graph": "t2c_traps", "category": "quoting", "question": "Return Ada's nickName property using bracket access.", "gold": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN p['nickName'] AS nickname", "habit": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN p.`nickName` AS nickname", "habit_outcome": "error"}
{"id": "named-param-11", "graph": "t2c_traps", "category": "quoting", "question": "How old is Cleo?", "gold": "MATCH (p:\"Person\" {name: 'Cleo'}) RETURN p.age AS age", "habit": "MATCH (p:\"Person\") WHERE p.name = $name RETURN p.age AS age", "habit_outcome": "error", "expect_index": true}
{"id": "slash-comment-12", "graph": "t2c_traps", "category": "quoting", "question": "Return the number one.", "gold": "RETURN 1 AS one", "habit": "RETURN 1 AS one // the answer", "habit_outcome": "error"}
{"id": "dir-known-13", "graph": "t2c_traps", "category": "direction", "question": "Who knows Bob?", "gold": "MATCH (a:\"Person\")-[:\"KNOWS\"]->(b:\"Person\" {name: 'Bob'}) RETURN a.name AS name", "habit": "MATCH (b:\"Person\" {name: 'Bob'})-[:\"KNOWS\"]->(a) RETURN a.name AS name", "habit_outcome": "different", "expect_index": true}
{"id": "dir-directed-14", "graph": "t2c_movies", "category": "direction", "question": "Who directed Static Bloom?", "gold": "MATCH (p:person)-[:directed]->(:\"Movie\" {title: 'Static Bloom'}) RETURN p.name AS name", "habit": "MATCH (:\"Movie\" {title: 'Static Bloom'})-[:directed]->(p:person) RETURN p.name AS name", "habit_outcome": "different"}
{"id": "dir-lives-15", "graph": "t2c_traps", "category": "direction", "question": "Which people live in Seoul?", "gold": "MATCH (p)-[:lives_in]->(:city {name: 'Seoul'}) RETURN p.name AS name", "habit": "MATCH (:city {name: 'Seoul'})-[:lives_in]->(p) RETURN p.name AS name", "habit_outcome": "different"}
{"id": "dir-agg-16", "graph": "t2c_movies", "category": "direction", "question": "How many actors acted in each movie? Return title and count.", "gold": "MATCH (:person)-[:acted_in]->(m:\"Movie\") RETURN m.title AS title, count(*) AS actors", "habit": "MATCH (m:\"Movie\")-[:acted_in]->(:person) RETURN m.title AS title, count(*) AS actors", "habit_outcome": "different"}
{"id": "dir-chain-17", "graph": "t2c_movies", "category": "direction", "question": "Which actors appeared in a movie directed by Ruth Okonjo?", "gold": "MATCH (:person {name: 'Ruth Okonjo'})-[:directed]->(m:\"Movie\")<-[:acted_in]-(a:person) RETURN DISTINCT a.name AS name"}
{"id": "dir-either-18", "graph": "t2c_traps", "category": "direction", "question": "Which people are connected to Bob by a KNOWS edge in either direction?", "gold": "MATCH (p:\"Person\")-[:\"KNOWS\"]-(b:\"Person\" {name: 'Bob'}) RETURN p.name AS name"}
{"id": "toint-19", "graph": "t2c_traps", "category": "functions", "question": "Bob's age is stored as a string. Return it as an integer.", "gold": "MATCH (p:\"Person\" {name: 'Bob'}) RETURN p.age::int4 AS age"}
{"id": "tofloat-20", "graph": "t2c_traps", "category": "functions", "question": "Return Cleo's age as a floating point number.", "gold": "MATCH (p:\"Person\" {name: 'Cleo'}) RETURN p.age::float8 AS age"}
{"id": "elementid-21", "graph": "t2c_traps", "category": "functions", "question": "Return Ada's vertex identifier.", "gold": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN id(p) AS gid", "habit": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN elementId(p) AS gid", "habit_outcome": "error"}
{"id": "reduce-22", "graph": "t2c_traps", "category": "functions", "question": "Sum the numbers 1 through 5 from a list.", "gold": "UNWIND [1, 2, 3, 4, 5] AS x RETURN sum(x) AS total", "habit": "RETURN reduce(s = 0, x IN [1, 2, 3, 4, 5] | s + x) AS total", "habit_outcome": "error"}
{"id": "upper-23", "graph": "t2c_movies", "category": "functions", "question": "Return each genre name in upper case.", "gold": "MATCH (g:genre) RETURN toupper(g.name) AS name", "habit": "MATCH (g:genre) RETURN apoc.text.upper(g.name) AS name", "habit_outcome": "error"}
{"id": "mapproj-24", "graph": "t2c_movies", "category": "functions", "question": "Return each movie as a map holding its title and year.", "gold": "MATCH (m:\"Movie\") RETURN {title: m.title, year: m.year} AS movie", "habit": "MATCH (m:\"Movie\") RETURN m {.title, .year} AS movie", "habit_outcome": "error"}
{"id": "patterncomp-25", "graph": "t2c_movies", "category": "functions", "question": "Collect the titles Ines Varga directed into one list.", "gold": "MATCH (:person {name: 'Ines Varga'})-[:directed]->(m:\"Movie\") RETURN collect(m.title) AS titles", "habit": "MATCH (p:person {name: 'Ines Varga'}) RETURN [(p)-[:directed]->(m) | m.title] AS titles", "habit_outcome": "error"}
{"id": "patternbool-26", "graph": "t2c_movies", "category": "functions", "question": "Which people directed at least one movie?", "gold": "MATCH (p:person) WHERE EXISTS((p)-[:directed]->()) RETURN p.name AS name", "habit": "MATCH (p:person) WHERE (p)-[:directed]->() RETURN p.name AS name", "habit_outcome": "error"}
{"id": "reverse-27", "graph": "t2c_traps", "category": "functions", "question": "Reverse each city's name.", "gold": "MATCH (c:city) RETURN string_reverse(c.name) AS reversed", "habit": "MATCH (c:city) RETURN reverse(c.name) AS reversed", "habit_outcome": "error"}
{"id": "count-noarg-28", "graph": "t2c_movies", "category": "functions", "question": "How many genres are there?", "gold": "MATCH (g:genre) RETURN count(*) AS n", "habit": "MATCH (g:genre) RETURN count() AS n", "habit_outcome": "error"}
{"id": "multilabel-29", "graph": "t2c_traps", "category": "functions", "question": "List the names of all students.", "gold": "MATCH (s:student) RETURN s.name AS name", "habit": "MATCH (s:\"Person\":student) RETURN s.name AS name", "habit_outcome": "error"}
{"id": "percentile-30", "graph": "t2c_movies", "category": "functions", "question": "What is the median (continuous percentile) movie year?", "gold": "MATCH (m:\"Movie\") WITH collect(m.year) AS years RETURN percentilecont(years, 0.5) AS median", "habit": "MATCH (m:\"Movie\") RETURN percentileCont(m.year, 0.5) AS median", "habit_outcome": "error"}
{"id": "regex-anchor-31", "graph": "t2c_traps", "category": "regex", "question": "Which people have code exactly 7? Match with a regular expression.", "gold": "MATCH (p:\"Person\") WHERE p.code =~ '^7$' RETURN p.name AS name", "habit": "MATCH (p:\"Person\") WHERE p.code =~ '7' RETURN p.name AS name", "habit_outcome": "different"}
{"id": "regex-case-32", "graph": "t2c_movies", "category": "regex", "question": "Which movie titles contain the word the, case-insensitively? Use a regex.", "gold": "MATCH (m:\"Movie\") WHERE m.title =~ '(?i)the' RETURN m.title AS title"}
{"id": "startswith-33", "graph": "t2c_movies", "category": "regex", "question": "Which movie titles start with The?", "gold": "MATCH (m:\"Movie\") WHERE m.title STARTS WITH 'The' RETURN m.title AS title"}
{"id": "contains-34", "graph": "t2c_movies", "category": "regex", "question": "Which people have a double s in their name?", "gold": "MATCH (p:person) WHERE p.name CONTAINS 'ss' RETURN p.name AS name"}
{"id": "endswith-35", "graph": "t2c_traps", "category": "regex", "question": "Which city names end with oul?", "gold": "MATCH (c:city) WHERE c.name ENDS WITH 'oul' RETURN c.name AS name"}
{"id": "nonstring-pred-36", "graph": "t2c_traps", "category": "regex", "question": "Which people have a 4 in their age, reading the age as text?", "gold": "MATCH (p:\"Person\") WHERE tostring(p.age) CONTAINS '4' RETURN p.name AS name", "habit": "MATCH (p:\"Person\") WHERE p.age CONTAINS '4' RETURN p.name AS name", "habit_outcome": "error"}
{"id": "split-37", "graph": "t2c_traps", "category": "regex", "question": "Split the string a,b,c on commas.", "gold": "RETURN split('a,b,c', ',') AS parts"}
{"id": "eq-strnum-38", "graph": "t2c_traps", "category": "jsonb", "question": "Which person has the code '42' (a string)?", "gold": "MATCH (p:\"Person\") WHERE p.code = '42' RETURN p.name AS name", "habit": "MATCH (p:\"Person\") WHERE p.code = 42 RETURN p.name AS name", "habit_outcome": "different", "expect_index": true}
{"id": "in-null-39", "graph": "t2c_traps", "category": "jsonb", "question": "Is 0 among Ada's scores? Return the boolean.", "gold": "MATCH (p:\"Person\" {name: 'Ada'}) RETURN 0 IN p.scores AS present"}
{"id": "crosstype-order-40", "graph": "t2c_traps", "category": "jsonb", "question": "Return every Person's name and age, sorted by age ascending in the server's ordering.", "gold": "MATCH (p:\"Person\") RETURN p.name AS name, p.age AS age ORDER BY p.age ASC", "ordered": true}
{"id": "truthy-41", "graph": "t2c_traps", "category": "jsonb", "question": "Which people have a non-empty scores list?", "gold": "MATCH (p:\"Person\") WHERE jsonb_array_length(p.scores) > 0 RETURN p.name AS name"}
{"id": "xor-precedence-42", "graph": "t2c_traps", "category": "jsonb", "question": "Evaluate: true OR false XOR true.", "gold": "RETURN true OR false XOR true AS v", "requires": ["gql_clauses"]}
{"id": "isnull-43", "graph": "t2c_traps", "category": "jsonb", "question": "Which Person nodes have no scores property?", "gold": "MATCH (p:\"Person\") WHERE p.scores IS NULL RETURN p.name AS name"}
{"id": "isunknown-44", "graph": "t2c_traps", "category": "jsonb", "question": "Which people's scores are unknown? Use IS UNKNOWN.", "gold": "MATCH (p:\"Person\") WHERE p.scores IS UNKNOWN RETURN p.name AS name", "requires": ["gql_clauses"]}
{"id": "concat-45", "graph": "t2c_traps", "category": "jsonb", "question": "Concatenate the string a with the number 1.", "gold": "RETURN 'a' + 1 AS s"}
{"id": "intdiv-46", "graph": "t2c_traps", "category": "jsonb", "question": "What is 7 divided by 2 in integer arithmetic?", "gold": "RETURN 7 / 2 AS q"}
{"id": "numeric-47", "graph": "t2c_traps", "category": "jsonb", "question": "Return the number 6.02E23.", "gold": "RETURN 6.02E23 AS n"}
{"id": "agg-groupby-48", "graph": "t2c_movies", "category": "aggregates", "question": "How many movies does each genre have?", "gold": "MATCH (:\"Movie\")-[:in_genre]->(g:genre) RETURN g.name AS genre, count(*) AS n"}
{"id": "agg-minmax-49", "graph": "t2c_movies", "category": "aggregates", "question": "What are the earliest and the latest movie years?", "gold": "MATCH (m:\"Movie\") RETURN min(m.year) AS earliest, max(m.year) AS latest"}
{"id": "agg-collect-50", "graph": "t2c_movies", "category": "aggregates", "question": "Collect all genre names, sorted, into one list.", "gold": "MATCH (g:genre) WITH g.name AS n ORDER BY n RETURN collect(n) AS genres"}
{"id": "agg-distinct-51", "graph": "t2c_movies", "category": "aggregates", "question": "How many distinct actors are there?", "gold": "MATCH (a:person)-[:acted_in]->() RETURN count(DISTINCT a.name) AS actors"}
{"id": "agg-all-52", "graph": "t2c_movies", "category": "aggregates", "question": "Count all acted_in relationships, spelling the ALL quantifier explicitly.", "gold": "MATCH ()-[r:acted_in]->() RETURN count(ALL r) AS n", "requires": ["gql_clauses"]}
{"id": "agg-avg-53", "graph": "t2c_traps", "category": "aggregates", "question": "What is the average age of Ada and Cleo?", "gold": "MATCH (p:\"Person\") WHERE p.name IN ['Ada', 'Cleo'] RETURN avg(p.age) AS average"}
{"id": "agg-having-54", "graph": "t2c_movies", "category": "aggregates", "question": "Which directors made exactly two movies? Name and count.", "gold": "MATCH (d:person)-[:directed]->(:\"Movie\") WITH d, count(*) AS n WHERE n = 2 RETURN d.name AS name, n"}
{"id": "let-55", "graph": "t2c_movies", "category": "gql", "question": "For each movie, bind its decade with LET and return title and decade.", "gold": "MATCH (m:\"Movie\") LET decade = m.year / 10 * 10 RETURN m.title AS title, decade", "requires": ["gql_clauses"]}
{"id": "filter-56", "graph": "t2c_movies", "category": "gql", "question": "Movies after 2020, using the FILTER clause.", "gold": "MATCH (m:\"Movie\") FILTER m.year > 2020 RETURN m.title AS title, m.year AS year", "requires": ["gql_clauses"]}
{"id": "next-57", "graph": "t2c_movies", "category": "gql", "question": "Count movies per genre, then keep only genres with at least three, chaining with NEXT.", "gold": "MATCH (:\"Movie\")-[:in_genre]->(g:genre) RETURN g.name AS genre, count(*) AS n NEXT FILTER n >= 3 RETURN genre, n", "requires": ["gql_clauses"]}
{"id": "for-offset-58", "graph": "t2c_traps", "category": "gql", "question": "Iterate the list ['a', 'b'] returning each element with its offset.", "gold": "FOR x IN ['a', 'b'] WITH OFFSET RETURN x, \"offset\"", "requires": ["gql_clauses"]}
{"id": "call-sub-59", "graph": "t2c_movies", "category": "gql", "question": "For each genre, the newest year among its movies, using a correlated CALL block.", "gold": "MATCH (g:genre) CALL (g) { MATCH (m:\"Movie\")-[:in_genre]->(g) RETURN max(m.year) AS newest } RETURN g.name AS genre, newest", "requires": ["gql_clauses"]}
{"id": "optcall-60", "graph": "t2c_movies", "category": "gql", "question": "For every person, the title of the 2024 movie they directed, if any; keep everyone.", "gold": "MATCH (p:person) OPTIONAL CALL (p) { MATCH (p)-[:directed]->(m:\"Movie\" {year: 2024}) RETURN m.title AS title } RETURN p.name AS name, title", "requires": ["gql_clauses"]}
{"id": "yield-61", "graph": "t2c_traps", "category": "gql", "question": "Return the numbers 1 through 3 using generate_series.", "gold": "LET one = 1 CALL generate_series(1, 3) YIELD generate_series AS n RETURN n", "requires": ["gql_clauses"]}
{"id": "exists-sub-62", "graph": "t2c_movies", "category": "gql", "question": "Which people both directed and acted? Use EXISTS blocks.", "gold": "MATCH (p:person) WHERE EXISTS { MATCH (p)-[:directed]->() } AND EXISTS { MATCH (p)-[:acted_in]->() } RETURN p.name AS name", "expect_empty": true, "requires": ["gql_clauses"]}
{"id": "count-sub-63", "graph": "t2c_movies", "category": "gql", "question": "Which people have more than two acting credits? Use a COUNT block.", "gold": "MATCH (p:person) WHERE COUNT { MATCH (p)-[:acted_in]->() } > 2 RETURN p.name AS name", "requires": ["gql_clauses"]}
{"id": "array-sub-64", "graph": "t2c_movies", "category": "gql", "question": "For the mystery genre, the sorted list of its movie years as an ARRAY block.", "gold": "MATCH (g:genre {name: 'mystery'}) RETURN ARRAY { MATCH (m:\"Movie\")-[:in_genre]->(g) RETURN m.year ORDER BY m.year } AS years", "requires": ["gql_clauses"]}
{"id": "value-sub-65", "graph": "t2c_movies", "category": "gql", "question": "The single newest movie year, as a VALUE block.", "gold": "RETURN VALUE { MATCH (m:\"Movie\") RETURN max(m.year) } AS newest", "requires": ["gql_clauses"]}
{"id": "return-all-66", "graph": "t2c_traps", "category": "gql", "question": "Return ALL city names, spelling the row quantifier explicitly.", "gold": "MATCH (c:city) RETURN ALL c.name AS name", "requires": ["gql_clauses"]}
{"id": "nullif-67", "graph": "t2c_traps", "category": "gql", "question": "For each Person, the name and the code, but null when the code is '42'.", "gold": "MATCH (p:\"Person\") RETURN p.name AS name, nullif(p.code, '42') AS code", "requires": ["gql_clauses"]}
{"id": "offset-68", "graph": "t2c_movies", "category": "gql", "question": "Movies by year ascending; use OFFSET to skip the first two, then take three.", "gold": "MATCH (m:\"Movie\") RETURN m.title AS title, m.year AS year ORDER BY year OFFSET 2 LIMIT 3", "ordered": true, "requires": ["gql_clauses"]}
{"id": "intersect-69", "graph": "t2c_movies", "category": "gql", "question": "Which genres do Quiet Cartography and The Salt Meridian share? Use INTERSECT.", "gold": "MATCH (:\"Movie\" {title: 'Quiet Cartography'})-[:in_genre]->(g) RETURN g.name AS name INTERSECT MATCH (:\"Movie\" {title: 'The Salt Meridian'})-[:in_genre]->(g) RETURN g.name AS name", "requires": ["gql_clauses"]}
{"id": "xor-where-70", "graph": "t2c_traps", "category": "gql", "question": "Which people either live in Seoul or are older than 30, but not both?", "gold": "MATCH (p:\"Person\") WHERE EXISTS((p)-[:lives_in]->(:city {name: 'Seoul'})) XOR p.age > 30 RETURN p.name AS name", "requires": ["gql_clauses"]}
{"id": "vle-71", "graph": "t2c_traps", "category": "paths", "question": "Who is reachable from Ada in one or two KNOWS hops?", "gold": "MATCH (:\"Person\" {name: 'Ada'})-[:\"KNOWS\"*1..2]->(p) RETURN p.name AS name"}
{"id": "vle-zero-72", "graph": "t2c_traps", "category": "paths", "question": "Ada herself plus everyone within one KNOWS hop of her.", "gold": "MATCH (:\"Person\" {name: 'Ada'})-[:\"KNOWS\"*0..1]->(p) RETURN p.name AS name"}
{"id": "shortest-73", "graph": "t2c_traps", "category": "paths", "question": "How many hops is the shortest KNOWS path from Ada to Cleo?", "gold": "MATCH (a:\"Person\" {name: 'Ada'}), (c:\"Person\" {name: 'Cleo'}) MATCH p = shortestpath((a)-[:\"KNOWS\"*]->(c)) RETURN length(p) AS hops"}
{"id": "dijkstra-74", "graph": "t2c_traps", "category": "paths", "question": "What is the cheapest road distance in km from Seoul to Tokyo?", "gold": "MATCH (s:city {name: 'Seoul'}), (t:city {name: 'Tokyo'}), (p, w) = dijkstra((s)-[r:road]->(t), r.km) RETURN w AS km"}
{"id": "path-names-75", "graph": "t2c_traps", "category": "paths", "question": "The names along the shortest KNOWS path from Ada to Cleo, in order.", "gold": "MATCH (a:\"Person\" {name: 'Ada'}), (c:\"Person\" {name: 'Cleo'}) MATCH p = shortestpath((a)-[:\"KNOWS\"*]->(c)) RETURN [x IN nodes(p) | x.name] AS names"}
{"id": "path-last-76", "graph": "t2c_traps", "category": "paths", "question": "The name of the last node on that shortest Ada-to-Cleo KNOWS path, via a negative index.", "gold": "MATCH (a:\"Person\" {name: 'Ada'}), (c:\"Person\" {name: 'Cleo'}) MATCH p = shortestpath((a)-[:\"KNOWS\"*]->(c)) RETURN nodes(p)[-1].name AS name"}
{"id": "gid-format-77", "graph": "t2c_traps", "category": "graphid", "question": "Is there any vertex with graph id 999999.999999? Return the count.", "gold": "MATCH (n) WHERE id(n) = 123.456 RETURN count(*) AS n", "habit": "MATCH (n) WHERE id(n) = 123 RETURN count(*) AS n", "habit_outcome": "error"}
{"id": "gid-order-78", "graph": "t2c_movies", "category": "graphid", "question": "Return person names ordered by their vertex identity.", "gold": "MATCH (p:person) RETURN p.name AS name ORDER BY p", "ordered": true, "requires": ["element_ordering"]}
{"id": "gid-identity-79", "graph": "t2c_movies", "category": "graphid", "question": "Count pairs of DISTINCT person vertices sharing the same name.", "gold": "MATCH (a:person), (b:person) WHERE a.name = b.name AND NOT a = b RETURN count(*) AS n"}
{"id": "stage-skip-80", "graph": "t2c_movies", "category": "staging", "question": "Order movies by year, skip the first, take the next two, and return their titles.", "gold": "MATCH (m:\"Movie\") ORDER BY m.year SKIP 1 LIMIT 2 RETURN m.title AS title"}
{"id": "stage-limit-81", "graph": "t2c_movies", "category": "staging", "question": "Take the two earliest movies by year, then drop the first of those two; return the title.", "gold": "MATCH (m:\"Movie\") ORDER BY m.year LIMIT 2 SKIP 1 RETURN m.title AS title"}
{"id": "union-82", "graph": "t2c_movies", "category": "staging", "question": "One deduplicated list of all names: genres and directors together.", "gold": "MATCH (g:genre) RETURN g.name AS name UNION MATCH (d:person)-[:directed]->() RETURN d.name AS name"}
{"id": "union-order-83", "graph": "t2c_movies", "category": "staging", "question": "Genre names and director names together, sorted as one list.", "gold": "CALL { MATCH (g:genre) RETURN g.name AS name UNION MATCH (d:person)-[:directed]->() RETURN d.name AS name } RETURN name ORDER BY name", "ordered": true, "requires": ["gql_clauses"]}
{"id": "case-84", "graph": "t2c_movies", "category": "staging", "question": "Label each movie old (before 2020) or new; return title and the label.", "gold": "MATCH (m:\"Movie\") RETURN m.title AS title, CASE WHEN m.year < 2020 THEN 'old' ELSE 'new' END AS era"}
{"id": "unwind-85", "graph": "t2c_traps", "category": "staging", "question": "Which of the names Ada, Zoe, Cleo exist as Person names? Check a literal list.", "gold": "UNWIND ['Ada', 'Zoe', 'Cleo'] AS candidate MATCH (p:\"Person\" {name: candidate}) RETURN p.name AS name"}
{"id": "arxiv-count-86", "graph": "arxiv", "category": "arxiv", "question": "How many papers are there?", "gold": "MATCH (p:\"Paper\") RETURN count(*) AS n"}
{"id": "arxiv-top-87", "graph": "arxiv", "category": "arxiv", "question": "The top three authors by number of papers, with their counts.", "gold": "MATCH (a:\"Author\")<-[:\"AUTHORED_BY\"]-(:\"Paper\") RETURN a.name AS name, count(*) AS papers ORDER BY papers DESC LIMIT 3", "ordered": true}
{"id": "arxiv-year-88", "graph": "arxiv", "category": "arxiv", "question": "How many papers were updated in the year 2015?", "gold": "MATCH (:\"Paper\")-[:\"UPDATED_IN\"]->(y:\"Year\" {year: 2015}) RETURN count(*) AS n"}
{"id": "arxiv-cats-89", "graph": "arxiv", "category": "arxiv", "question": "How many categories exist?", "gold": "MATCH (c:\"Category\") RETURN count(*) AS n"}
{"id": "arxiv-years-90", "graph": "arxiv", "category": "arxiv", "question": "How many distinct years are tracked?", "gold": "MATCH (y:\"Year\") RETURN count(*) AS n"}
{"id": "sarg-arith-91", "graph": "t2c_movies", "category": "sargability", "question": "Which movies came out after 2020? Compare the year directly and return the titles.", "gold": "MATCH (m:\"Movie\") WHERE m.year > 2020 RETURN m.title AS title", "expect_index": true, "habit": "MATCH (m:\"Movie\") WHERE m.year + 0 > 2020 RETURN m.title AS title", "habit_outcome": "unindexed"}
{"id": "sarg-coalesce-92", "graph": "t2c_movies", "category": "sargability", "question": "Titles of movies after 2020.", "gold": "MATCH (m:\"Movie\") WHERE m.year > 2020 RETURN m.title AS title", "expect_index": true, "habit": "MATCH (m:\"Movie\") WHERE coalesce(m.year, 0) > 2020 RETURN m.title AS title", "habit_outcome": "unindexed"}
{"id": "sarg-prefix-93", "graph": "t2c_movies", "category": "sargability", "question": "Titles that start with The, written so the title index can serve it.", "gold": "MATCH (m:\"Movie\") WHERE m.title >= 'The' AND m.title < 'Thf' RETURN m.title AS title", "expect_index": true, "habit": "MATCH (m:\"Movie\") WHERE m.title STARTS WITH 'The' RETURN m.title AS title", "habit_outcome": "unindexed"}
{"id": "sarg-neq-94", "graph": "t2c_traps", "category": "sargability", "question": "Which cities are not Seoul?", "gold": "MATCH (c:city) WHERE c.name IN ['Berlin', 'Busan', 'Tokyo'] RETURN c.name AS name", "expect_index": true, "habit": "MATCH (c:city) WHERE c.name <> 'Seoul' RETURN c.name AS name", "habit_outcome": "unindexed"}
{"id": "sarg-lower-95", "graph": "t2c_traps", "category": "sargability", "question": "Find the person named ADA, whatever the letter case.", "gold": "MATCH (p:\"Person\") WHERE tolower(p.name) = 'ada' RETURN p.name AS name", "expect_index": true, "habit": "MATCH (p:\"Person\") WHERE p.name =~ '(?i)^ada$' RETURN p.name AS name", "habit_outcome": "unindexed"}
{"id": "sarg-order-96", "graph": "t2c_movies", "category": "sargability", "question": "The three earliest movies with their years.", "gold": "MATCH (m:\"Movie\") RETURN m.title AS title, m.year AS year ORDER BY year LIMIT 3", "ordered": true, "expect_index": true}
{"id": "sarg-isnull-97", "graph": "t2c_traps", "category": "sargability", "question": "Which people have no code property?", "gold": "MATCH (p:\"Person\") WHERE p.code IS NULL RETURN p.name AS name", "expect_index": true}
{"id": "sarg-in-98", "graph": "t2c_movies", "category": "sargability", "question": "Movies from 2019 or 2024, with the year.", "gold": "MATCH (m:\"Movie\") WHERE m.year IN [2019, 2024] RETURN m.title AS title, m.year AS year", "expect_index": true}
{"id": "sarg-range-99", "graph": "t2c_movies", "category": "sargability", "question": "Movies from 2019 through 2021 inclusive, with the year.", "gold": "MATCH (m:\"Movie\") WHERE m.year >= 2019 AND m.year <= 2021 RETURN m.title AS title, m.year AS year", "expect_index": true}
{"id": "truthy-100", "graph": "t2c_traps", "category": "jsonb", "question": "Which people have anything in their scores list?", "gold": "MATCH (p:\"Person\") WHERE jsonb_array_length(p.scores) > 0 RETURN p.name AS name", "habit": "MATCH (p:\"Person\") WHERE p.scores RETURN p.name AS name", "habit_outcome": "error", "requires": ["boolean_condition"]}
