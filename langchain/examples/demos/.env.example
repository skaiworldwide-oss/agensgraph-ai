# ── langchain-agensgraph demos: environment ────────────────────────────────
# Copy this file to ".env" IN THIS SAME DIRECTORY and fill in the values:
#
#     cp examples/demos/.env.example examples/demos/.env
#
# The demos load this file automatically (python-dotenv). The assistant never
# reads or prints the values — only the variable names.

# ── OpenAI (used for ALL embeddings and LLM calls — nothing runs locally) ───
OPENAI_API_KEY=sk-...your-key-here...

# ── AgensGraph connection (live DB is on localhost:55432) ───────────────────
# Either set these five...
AGENSGRAPH_DB=
AGENSGRAPH_USER=
AGENSGRAPH_PASSWORD=
AGENSGRAPH_HOST=localhost
AGENSGRAPH_PORT=55432
# ...or, alternatively, a single URL (takes precedence if set):
# AGENSGRAPH_URL=postgresql://user:password@localhost:55432/dbname

# ── Optional: models (defaults are cheap; remote OpenAI only) ───────────────
# DEMO_EMBED_MODEL=text-embedding-3-small     # 1536-dim, cheapest
# DEMO_LLM_MODEL=gpt-4o-mini                  # cheap + fast

# ── Optional: scale knobs (defaults are "big"; lower these for a cheap run) ─
# ARXIV_LIMIT=50000      # papers ingested by 01_arxiv_graphrag
# NEWS_LIMIT=100000      # chunks ingested by 03_news_vector_rag
# WIKI_LIMIT=500         # articles processed by 02_wikipedia_kg (LLM cost)
