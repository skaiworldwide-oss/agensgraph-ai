# Copy to `.env` (in this folder) and fill in. The .env is git-ignored.
# Only OPENAI_API_KEY is strictly required; the AgensGraph settings default to the
# local dev instance (trust auth on localhost:55432).

# --- OpenAI (all embeddings + LLM calls go here; nothing runs locally) ---
OPENAI_API_KEY=

# --- AgensGraph connection (the integration reads these; AGENS_* also accepted) ---
# Each demo uses its OWN database (lightrag_wiki / lightrag_news / lightrag_curation /
# lightrag_tenants), created automatically on first run — do NOT set AGENSGRAPH_DB here.
AGENSGRAPH_USER=
AGENSGRAPH_PASSWORD=
AGENSGRAPH_HOST=localhost
AGENSGRAPH_PORT=55432

# --- Optional model overrides ---
# DEMO_LLM_MODEL=gpt-4o-mini
# DEMO_EMBED_MODEL=text-embedding-3-small
# DEMO_EMBED_DIM=1536

# --- Optional scale knobs (every build script prints a cost estimate first) ---
# WIKI_LIMIT=1000        # demo 1/3: Wikipedia articles
# NEWS_LIMIT=1000        # demo 2: CC-News articles
# EMBED_BATCH=32
